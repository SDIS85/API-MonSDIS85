PORT=3000
NODE_ENV=development

LDAP_URLS=ldaps://ldap1.example.com:636,ldaps://ldap2.example.local:636
LDAP_BASE_DN=DC=example,DC=local

LDAP_BIND_DN=CN=svc_example,OU=example3,OU=example2,OU=example1,OU=example0,DC=example,DC=local

LDAP_BIND_PASSWORD=P4ssw0rd
LDAP_USER_FILTER=(sAMAccountName={{username}})

LDAP_ALLOWED_GROUPS=CN=EXAMPLE_USER,OU=EXAMPLE3,OU=EXAMPLE2,OU=EXAMPLE1,OU=EXAMPLE0,DC=example,DC=local
LDAP_REQUIRE_TLS=true

LDAP_CA_CERT_PATH=./src/config/certs/sdis_ldap.crt

LDAP_CONNECT_TIMEOUT=5000
LDAP_TIMEOUT=5000